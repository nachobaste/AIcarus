#!/usr/bin/env python3
"""devbrain-vigia — daily watch of the scheduled jobs: "did the work get done", not just "did it exit 0".

Read-only and offline. Prints a short section with actionable findings (what is happening, since
when, what to do) or a "no findings" line. The only things it writes are its own state
(VIGIA_STATE) and log (VIGIA_LOG). bin/devbrain-digest consumes it. On a machine without launchd
it prints nothing: there is nothing to watch.

It looks at every launchd job whose plist label starts with VIGIA_LABEL_PREFIX (the jobs
setup.sh writes: com.devbrain.*):

  not loaded : the plist exists in ~/Library/LaunchAgents but launchd does not have the job.
               launchd does not record since when, so after a reboot with nobody logged in
               (no graphical session) none of them runs, and this says so.
  failing    : `launchctl print` reports a last exit code other than 0.
  stalled    : loaded, but its `runs` counter has not moved for UMBRAL (3) times its interval.
               launchd does not give the time of the last run, so the counter is stored at each
               watch and the script looks at how long it has stood still.

ponytail: a job scheduled several times a day is judged by its shortest nominal interval only
(conservative); a job with no interval (KeepAlive, WatchPaths) is not checked for stalling.
Add a check of what the job actually produced (a ledger of runs) if you need "ran but did
nothing"; the starter kit has no such ledger to read.
"""
import datetime as dt, json, os, plistlib, re, shutil, subprocess, sys

E = os.environ.get
HOME = os.path.expanduser("~")
LAUNCHD = E("VIGIA_LAUNCHD_DIR", f"{HOME}/Library/LaunchAgents")
PREFIX = E("VIGIA_LABEL_PREFIX", "com.devbrain.")
LAUNCHCTL = E("VIGIA_LAUNCHCTL", "launchctl")
STATE = E("VIGIA_STATE", f"{HOME}/.openclaw/state/vigia.json")
LOG = E("VIGIA_LOG", f"{HOME}/.openclaw/logs/vigia.log")
THRESHOLD = float(E("VIGIA_UMBRAL", "3"))
UTC = dt.timezone.utc


def now():
    a = E("VIGIA_NOW")
    return dt.datetime.fromisoformat(a.replace("Z", "+00:00")).astimezone(UTC) if a else dt.datetime.now(UTC)


def parse(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone(UTC)


def days(td):
    return td.total_seconds() / 86400


def lc(*a):
    return subprocess.run([LAUNCHCTL, *a], capture_output=True, text=True, timeout=30).stdout


def interval(p):
    """Seconds between runs of a plist; None if it cannot be inferred."""
    if "StartInterval" in p:
        return p["StartInterval"]
    sc = p.get("StartCalendarInterval")
    if sc is None:
        return None
    ds = sc if isinstance(sc, list) else [sc]
    f = lambda d: 7 * 86400 if "Weekday" in d else 30 * 86400 if "Day" in d else 86400 if "Hour" in d else 3600
    return min(f(d) for d in ds)  # ponytail: several entries a day are not divided; it comes out conservative


def boot():
    b = E("VIGIA_BOOT_EPOCH")
    if b is None:
        m = re.search(r"sec = (\d+)", subprocess.run(["sysctl", "-n", "kern.boottime"],
                                                     capture_output=True, text=True).stdout)
        b = m.group(1) if m else None
    return dt.datetime.fromtimestamp(int(b), UTC) if b else None


def read_plist(path):
    try:
        with open(path, "rb") as fh:
            return plistlib.load(fh)
    except Exception:  # a plist with `--` in a comment is invalid XML that launchd tolerates
        return json.loads(subprocess.run(["plutil", "-convert", "json", "-o", "-", path],
                                         capture_output=True, text=True, check=True).stdout)


def watch(t, st):
    plists = {}
    for f in sorted(os.listdir(LAUNCHD)) if os.path.isdir(LAUNCHD) else []:
        if f.startswith(PREFIX) and f.endswith(".plist"):
            p = read_plist(os.path.join(LAUNCHD, f))
            plists[p.get("Label", f[:-6])] = (p, os.path.join(LAUNCHD, f))
    loaded = {l.split("\t")[-1].strip() for l in lc("list").splitlines()}
    uid = os.getuid()
    out, not_loaded, seen = [], [], st.setdefault("jobs", {})
    for lab, (p, path) in plists.items():
        if lab not in loaded:
            not_loaded.append(lab)
            continue
        pr = lc("print", f"gui/{uid}/{lab}")
        runs = re.search(r"\bruns = (\d+)", pr)
        ex = re.search(r"last exit code = (-?\d+)", pr)
        if ex and int(ex.group(1)) != 0:
            out.append(f"[jobs] {lab}: last exit code {ex.group(1)} (runs since it loaded: "
                       f"{runs.group(1) if runs else '?'}). What to do: `tail ~/Library/Logs/devbrain-{lab[len(PREFIX):]}.log`.")
        iv = interval(p)
        if runs and iv:
            v = seen.get(lab)
            if not v or v["runs"] != int(runs.group(1)):
                seen[lab] = {"runs": int(runs.group(1)), "since": t.isoformat()}
            elif (t - parse(v["since"])).total_seconds() > THRESHOLD * iv:
                out.append(f"[jobs] {lab}: loaded but not executed since {v['since'][:10]} "
                           f"(it runs every {iv/3600:.1f} h; {THRESHOLD:.0f}x = {THRESHOLD*iv/3600:.0f} h). "
                           f"What to do: `launchctl kickstart gui/{uid}/{lab}` and check its log.")
    if not_loaded:
        b = boot()
        reboot = (f" The machine rebooted on {b:%Y-%m-%d %H:%M} UTC: after a reboot with no graphical "
                  "session (nobody signed in) no LaunchAgent runs." if b and days(t - b) < 3 else "")
        out.insert(0, f"[jobs] {len(not_loaded)} job(s) with a plist but NOT loaded in launchd: {', '.join(not_loaded)}. "
                      f"launchd does not record since when.{reboot} What to do: sign in on the machine and "
                      f"`launchctl bootstrap gui/{uid} {LAUNCHD}/<label>.plist`.")
    return out


def main():
    if not shutil.which(LAUNCHCTL):
        return  # no launchd here (Linux, cron): nothing to watch, and no section in the digest
    t = now()
    try:
        st = json.load(open(STATE))
    except (OSError, ValueError):
        st = {}
    try:
        out = watch(t, st)
    except Exception as e:  # a broken reader is said, not hidden, and does not take the digest down
        out = [f"[jobs] could not read ({type(e).__name__}: {e})."]
    for path in (STATE, LOG):
        os.makedirs(os.path.dirname(path), exist_ok=True)
    json.dump(st, open(STATE, "w"))
    with open(LOG, "a") as h:
        h.write(f"{t.isoformat()} findings={len(out)}\n")
    print("\n".join(f"  - {l}" for l in out) if out else "  no findings")


if __name__ == "__main__":
    main()
