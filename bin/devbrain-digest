#!/bin/bash
# devbrain-digest — daily summary (early morning). Git/PR activity + wiki changes +
# pending research proposals + blocked tasks + unclassified repos. Written by
# Claude Code (precise), delivered via Telegram. This job NEVER writes anything —
# only reads and summarizes.
#
# This is the CORE digest. If you build your own personal read-only briefing
# (email/calendar/tasks) on top of this system, keep it in a SEPARATE script and
# treat it as personal-data tier (read live, answer, forget — see README.md) —
# the starter kit deliberately ships without one, since it's specific to whatever
# personal tools you use.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
ROOT_LIB="$(cd "$(dirname "$0")/.." && pwd)/lib"
source "$ROOT_LIB/telegram.sh"   # tg_send_with_fallback
source "$ROOT_LIB/queue.sh"      # fm_get (reading status: blocked)
source "$ROOT_LIB/models.sh"     # models_resolve (no --model by default)
# Overridable so this script can be tested without ever calling out to the real
# tools — otherwise `export PATH=...` two lines up defeats a PATH-prepend trick,
# and a test that forgets this reaches the real messaging bridge and sends a live
# Telegram digest.
CLAUDE_BIN="${DEVBRAIN_DIGEST_CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
OPENCLAW_BIN="${DEVBRAIN_DIGEST_OPENCLAW_BIN:-openclaw}"
GH_BIN="${DEVBRAIN_DIGEST_GH_BIN:-gh}"
PROJECTS_DIR="${DEVBRAIN_PROJECTS_DIR:-$HOME/dev/projects}"
WIKI_DIR="${DEVBRAIN_WIKI_DIR:-$HOME/dev/wiki}"
QUEUE_DIR="${DEVBRAIN_QUEUE_DIR:-$HOME/dev/queue}"
# How many days a pending decision (Proposals or Blocked) can sit before the digest
# flags it visually instead of just quietly ageing. Exported so research_promote.py
# below uses the exact same number — one knob, both sections, no risk of the two
# disagreeing about what counts as old.
export DEVBRAIN_DIGEST_STALE_DAYS="${DEVBRAIN_DIGEST_STALE_DAYS:-3}"
LOG="${DEVBRAIN_DIGEST_LOG:-$HOME/.openclaw/logs/digest.log}"
echo "[$(date)] digest start" >> "$LOG"

# Collect last-24h activity per project (read-only)
ACTIVITY=""
for d in "$PROJECTS_DIR"/*/; do
  [ -d "$d/.git" ] || continue
  name=$(basename "$d")
  commits=$(git -C "$d" log --since="24 hours ago" --pretty="  - %s (%an)" 2>/dev/null)
  [ -n "$commits" ] && ACTIVITY="$ACTIVITY\n### $name\n$commits"
done
# Open PRs from devbrain, waiting on review
PRS=$("$GH_BIN" search prs --author "@me" --state open --json repository,title,url 2>/dev/null \
  --jq '.[] | "  - \(.title) → \(.url)"' 2>/dev/null | head -20)

# Night report (written by devbrain-night). devbrain-night only rewrites it when it runs; with
# the night off the file stays frozen and would repeat the last block forever. It is ignored
# when its header ("# Night report — YYYY-MM-DD HH:MM") is older than 36 h or cannot be read.
NIGHT=""
if [ -f "$QUEUE_DIR/night-report-latest.md" ]; then
  _rep_age=$(python3 -I -c '
import datetime, sys
try:
    t = datetime.datetime.strptime(sys.argv[1], "%Y-%m-%d %H:%M")
    print(int((datetime.datetime.now() - t).total_seconds()))
except ValueError:
    pass
' "$(sed -n '1s/^# Night report — //p' "$QUEUE_DIR/night-report-latest.md")" 2>/dev/null)
  case "$_rep_age" in ''|*[!0-9-]*) ;; *) [ "$_rep_age" -le 129600 ] && NIGHT=$(cat "$QUEUE_DIR/night-report-latest.md") ;; esac
fi
# Status board (shared knowledge across repos)
BOARD=""
for b in "$WIKI_DIR/status/"*.md; do
  [ -e "$b" ] || continue
  BOARD="$BOARD\n### $(basename "$b" .md)\n$(head -15 "$b")"
done
# What agents wrote to the wiki (system memory) in the last 24h — human eyes on it
WIKIDIFF=$(git -C "$WIKI_DIR" log --since="24 hours ago" --stat 2>/dev/null | head -25)

# What the messaging-bridge agent invoked in the last 24h — observability (silence
# is the risky state). `openclaw audit` is metadata ONLY (which runs/tools ran, no
# content). Additive and defensive: if it fails, this stays empty and the digest
# continues (set -u, no -e).
AUDIT=""
if command -v "$OPENCLAW_BIN" >/dev/null 2>&1; then
  SINCE_MS=$(( ($(date +%s) - 86400) * 1000 ))
  AUDIT=$("$OPENCLAW_BIN" audit --after "$SINCE_MS" --json --limit 300 2>/dev/null | python3 -c '
import json,sys
from collections import Counter
try:
    ev=json.load(sys.stdin).get("events",[])
except Exception:
    sys.exit()
if not ev: sys.exit()
runs=sum(1 for e in ev if e.get("kind")=="agent_run")
tools=[e for e in ev if e.get("kind")=="tool_action"]
bad=[e for e in ev if e.get("status") not in ("succeeded","started","unknown",None)]
byt=Counter(e.get("toolName","?") for e in tools)
parts=", ".join(k+":"+str(v) for k,v in byt.most_common())
line=str(runs)+" agent runs, "+str(len(tools))+" tool actions"
if parts: line+=" ("+parts+")"
print(line)
for e in bad[:8]:
    print("  ! "+str(e.get("kind"))+" "+str(e.get("status"))+" "+str(e.get("toolName") or e.get("action") or ""))
' 2>/dev/null)
fi

# Proposals from the research shift waiting on a decision. This block bypasses the
# AI summarizer below on purpose: a Telegram approval path (e.g. replying "dale 2")
# needs the numbering to stay exact and stable. A model asked to "summarize" is
# free to reword or drop a line; a plain append is not.
PROPOSALS=""
BACKLOG_FILE="$WIKI_DIR/projects/mejoras-propuestas.md"
if [ -f "$BACKLOG_FILE" ]; then
  PROPOSALS="$(python3 "$ROOT_LIB/research_promote.py" digest < "$BACKLOG_FILE" 2>>"$LOG")"
fi

# Repos that devbrain-repo-audit finds unclassified or not cloned locally —
# textual, same reason as Proposals/Blocked: a repo name shouldn't pass through the
# AI summarizer. Never fails the digest if the binary doesn't exist or `gh` doesn't
# respond (set -u, no -e; the script itself returns 2 and prints nothing else in
# that case).
REPO_AUDIT_BIN="${DEVBRAIN_REPO_AUDIT_BIN:-$(dirname "$0")/devbrain-repo-audit}"
UNCLASSIFIED=""
if [ -x "$REPO_AUDIT_BIN" ]; then
  AUDIT_OUT=$("$REPO_AUDIT_BIN" 2>>"$LOG")
  UNCLASSIFIED=$(printf '%s\n' "$AUDIT_OUT" | awk -F'\t' '
    $1 == "repo-not-cloned"   { print "  - " $2 " — not cloned locally (last push: " $3 ")" }
    $1 == "repo-unclassified" { print "  - " $2 " — not added to .allow or .excluded (last push: " $3 ")" }
  ')
fi

# Blocked tasks: a missing permission stops being a silent failure and becomes a
# named decision on the board — "add this line to devbrain-verify.commands".
# Built separately and appended verbatim, same reason as the proposals section:
# the exact command shouldn't pass through the AI summarizer.
#
# Age: there's no "when did this get blocked" date field in the frontmatter
# (bin/devbrain-night only writes status + bloqueado_por), so the only signal
# available is the file's last modification — a PROXY, not a confirmed blocking
# date (see queue_file_age_days in lib/queue.sh). That's why it's marked with "~"
# and "per last modification" instead of saying "blocked since".
BLOCKED=""
for f in "$QUEUE_DIR"/*.plan.md; do
  [ -e "$f" ] || continue
  [ "$(fm_get "$f" status)" = "blocked" ] || continue
  age="$(queue_file_age_days "$f" 2>/dev/null)"
  case "$age" in ''|*[!0-9]*) age="" ;; esac
  suffix=""
  bullet="-"
  if [ -n "$age" ]; then
    word="days"; [ "$age" = "1" ] && word="day"
    suffix=" (blocked ~$age $word ago, per last modification)"
    [ "$age" -ge "$DEVBRAIN_DIGEST_STALE_DAYS" ] && bullet="⚠️"
  fi
  BLOCKED="${BLOCKED}${bullet} $(basename "$f") → missing: \`$(fm_get "$f" bloqueado_por)\`${suffix}
"
done

# Approved plans the premise gate will not let run (FALSE, UNVERIFIABLE or unverified premises): the only
# thing about an `approved` plan that needs you. Textual, one line per plan, with the reason.
PREMISE_HELD=""
for f in "$QUEUE_DIR"/*.plan.md; do
  [ -e "$f" ] || continue
  [ "$(fm_get "$f" status)" = "approved" ] || continue
  _pm="$(queue_premisas_ok "$f" 2>&1)" && continue
  PREMISE_HELD="${PREMISE_HELD}- #$(fm_get "$f" prioridad) $(basename "$f") → $(printf '%s' "$_pm" | tr '\n' ' ' | cut -c1-200)
"
done

# Plans the tenth man blocks (not overridden), and how its dissents have turned out. Textual, one line per plan.
TENTH_HELD=""
for f in "$QUEUE_DIR"/*.plan.md; do
  [ -e "$f" ] || continue
  case "$(fm_get "$f" status)" in requested|approved) ;; *) continue ;; esac
  queue_disenso_bloquea "$f" || continue
  TENTH_HELD="${TENTH_HELD}- #$(fm_get "$f" prioridad) $(basename "$f")
"
done
TENTH_COUNTS="$(tenth_counts "$QUEUE_DIR")"
case "$TENTH_COUNTS" in "overridden 0 · confirmed 0 · wrong 0 · right 0 · missed 0") TENTH_COUNTS="" ;; esac

# The watch: scheduled jobs that are not loaded, failing or stalled (bin/devbrain-vigia).
# Textual, never through the AI summarizer. It prints nothing on a machine without launchd (no
# section then); "no findings" is one line, and if the script itself fails the digest says so.
VIGIA_BIN="${DEVBRAIN_VIGIA_BIN:-$(dirname "$0")/devbrain-vigia}"
VIGIA=""
if [ -x "$VIGIA_BIN" ]; then
  VIGIA="$("$VIGIA_BIN" 2>>"$LOG")" || VIGIA="  ⚠️ could not run the watch (see $LOG)"
fi
# Findings (or a failure to look) must not sit under an "All quiet."
VIGIA_FINDINGS=0
[ -n "$VIGIA" ] && ! printf '%s' "$VIGIA" | grep -q 'no findings' && VIGIA_FINDINGS=1

if [ -z "$ACTIVITY" ] && [ -z "$PRS" ] && [ -z "$NIGHT" ] && [ -z "$AUDIT" ] && [ -z "$PROPOSALS" ] && [ -z "$BLOCKED" ] && [ -z "$UNCLASSIFIED" ]; then
  MSG="☀️ Good morning. No code changes in the last 24h."
  [ "$VIGIA_FINDINGS" -eq 0 ] && MSG="$MSG All quiet."
else
  CONTEXT="Night report:\n${NIGHT:-(no recent night report: the night did not run)}\n\nGit activity last 24h:${ACTIVITY:-\n(none)}\n\nOpen PRs waiting on your review:\n${PRS:-  (none)}\n\nStatus board:\n${BOARD:-(empty)}\n\nWiki changes (24h):\n${WIKIDIFF:-(none)}\n\nMessaging-bridge agent actions in 24h (metadata):\n${AUDIT:-(none)}"
  # No --model by default (Claude Code's own). A rejected model config skips the call
  # and falls into the "generator failed" line below; the reason goes to the log.
  MSG=""
  models_resolve digest "" "" 2>>"$LOG" && \
  MSG=$(printf '%s' "$CONTEXT" | "$CLAUDE_BIN" -p ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} \
    "You are the user's assistant. With this raw data, write a BRIEF morning summary
to read on a phone (max 160 words). Start with '☀️ Summary'.
Structure: 1) what the night accomplished (PRs ready, failures), 2) what's waiting
on a merge, 3) one line on the overall board status, 4) if the wiki changed, say so
(it's the system's memory and worth knowing what got written), 5) what the
messaging-bridge agent invoked — only if there were failed/blocked actions or an
unusual volume, otherwise omit it.
Do NOT mention 'proposals' or the research shift: that section is appended
separately, verbatim, after your summary — mentioning it yourself would duplicate
or paraphrase it. If there are repeated frictions, suggest ONE concrete improvement
at the end. Be concrete, no filler. Data:
$(cat)" 2>>"$LOG")
  [ -z "$MSG" ] && MSG="☀️ Summary: there was activity but the generator failed. Check manually. (see digest.log)"
fi

# The proposals block is appended AFTER the AI-generated summary, verbatim — see
# the comment above where PROPOSALS is built.
if [ -n "$PROPOSALS" ]; then
  MSG="$MSG

📋 Proposals waiting on your decision:
$PROPOSALS"
fi

if [ -n "$BLOCKED" ]; then
  MSG="$MSG

🚧 Blocked tasks, waiting for you to add the permission:
$BLOCKED"
fi

if [ -n "$PREMISE_HELD" ]; then
  MSG="$MSG

🧪 Approved plans held by their premises (run devbrain-verifier <plan>, or change <n>: ...):
$PREMISE_HELD"
fi

if [ -n "$TENTH_HELD" ] || [ -n "$TENTH_COUNTS" ]; then
  MSG="$MSG

🔟 Tenth man${TENTH_HELD:+ — plans it blocks (read its section, then change <n>: ... or approve <n> <note>):
$TENTH_HELD}${TENTH_COUNTS:+
$TENTH_COUNTS}"
fi

if [ -n "$UNCLASSIFIED" ]; then
  MSG="$MSG

🔍 Unclassified repos (add them to .allow or .excluded):
$UNCLASSIFIED"
fi

if [ -n "$VIGIA" ]; then
  MSG="$MSG

🔭 Watch (scheduled jobs):
$VIGIA"
fi

# Telegram is not in the critical path for ALERTS elsewhere (bin/devbrain-night),
# but the digest's entire job IS delivering this message — if it silently stays on
# the gateway-only path and the gateway is down, nobody sees the proposals, nothing
# gets approved, and the queue dries up again. tg_send_with_fallback tries the
# bridge first (no extra API call in the common case) and only reaches for curl if
# that fails.
tg_send_with_fallback "$OPENCLAW_BIN" "$MSG" "$LOG"
echo "[$(date)] digest sent" >> "$LOG"
