#!/bin/bash
# devbrain-wiki-lint — weekly wiki maintenance (Karpathy pattern: lint).
# Claude Code looks for contradictions, stale data, orphaned pages; fixes and commits.
# Design: ARCHITECTURE.md (wiki maintenance section). Runs weekly via launchd.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
WIKI="$HOME/dev/wiki"
if [ -z "${DEVBRAIN_TG_CHAT_ID:-}" ]; then
  echo "devbrain-wiki-lint: DEVBRAIN_TG_CHAT_ID is not set (your Telegram chat id)." >&2
  echo "devbrain-wiki-lint: there is no default -- set it in the environment before running this." >&2
  exit 1
fi
TG_ID="$DEVBRAIN_TG_CHAT_ID"
LOG="$HOME/.openclaw/logs/wiki-lint.log"
OPENCLAW_BIN="${DEVBRAIN_WIKI_LINT_OPENCLAW_BIN:-openclaw}"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/telegram.sh"   # tg_send_with_fallback
source "$(cd "$(dirname "$0")/.." && pwd)/lib/models.sh"     # models_resolve
echo "[$(date)] wiki-lint start" >> "$LOG"
cd "$WIKI" || exit 1

# Link resolution is decidable, so decide it instead of asking the model to
# eyeball ~240 links (that is the blind-verification trap from
# wiki/lessons/verificacion-ciega-probar-el-instrumento.md). The model gets an
# exact list to repair and spends its judgement on the parts that need it.
LINKCHECK="$(cd "$(dirname "$0")" && pwd)/wiki-linkcheck"
BROKEN="$("$LINKCHECK" "$WIKI" 2>&1)"
echo "[$(date)] wiki-lint linkcheck: $(printf '%s' "$BROKEN" | head -2 | tr '\n' ' ')" >> "$LOG"

CLAUDE_BIN="${DEVBRAIN_WIKI_LINT_CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
# No --model by default (Claude Code's own); config/models.conf can set one. A rejected
# value skips the session, and the weekly message says why.
SUMMARY="model config rejected, lint skipped (see $LOG)"
models_resolve wikilint "" "" 2>>"$LOG" && \
SUMMARY=$("$CLAUDE_BIN" -p ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} --permission-mode acceptEdits \
  --allowedTools "Read,Glob,Grep,Edit,Write,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*)" \
  "You are the maintainer of this wiki (~/dev/wiki). Read SCHEMA.md for the rules. Do a LINT:
1) Look for contradictions between pages, stale data, and orphaned pages (no links to them).
2) Verify that index.md lists every page. Broken links are ALREADY detected —
   this is \`wiki-linkcheck\`'s report, fix exactly these and no others:
--- start of report ---
$BROKEN
--- end of report ---
   For each one: if the page exists under another name, repoint the link; if it doesn't
   exist anywhere in the wiki, convert it to plain text. NEVER invent a page to satisfy a link.
   Use relative markdown links, the format SCHEMA.md asks for.
3) Fix what you can directly (small, safe edits). Do NOT delete pages.
4) Log the pass in log.md, format '## [YYYY-MM-DD] lint | summary'.
5) Commit the changes with the message 'wiki: weekly lint'. Do NOT push.
At the end, reply in English, 1-3 lines, on what you found and fixed." 2>>"$LOG")

git push -q 2>>"$LOG" || true   # push the lint's commit

# check <count-prefix> <ok-text> <what> <cmd...>: runs a checker ONCE. Exit 0
# prints <ok-text>; anything else logs the full report and prints its count.
check() {
  local pfx="$1" ok="$2" what="$3" out
  shift 3
  if out="$("$@" 2>&1)"; then
    echo "$ok"
  else
    { echo "[$(date)] wiki-lint $pfx:"; printf '%s\n' "$out"; } >> "$LOG"
    echo "⚠️ $(printf '%s\n' "$out" | sed -n "s/^$pfx: //p") $what"
  fi
}

# Verify the repair actually landed. Trusting the model's own summary here is
# the same mistake this script exists to stop.
LINKS="$(check unresolved "links OK" "broken link(s) remain" "$LINKCHECK" "$WIKI")"

# Drift between stores, and orphaned stacked-PR merges, are reported, never
# repaired here: fixing either means writing to machine-config (drift) or to
# someone else's repo history (stacked PRs), and machine-config is
# interactive-only (see wiki/lessons/machine-config-nunca-nocturno.md).
# That is also why neither report is handed to the model above the way broken
# links are.
DRIFTCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-drift"
DRIFT="$(check drift "no drift" "drift between stores" "$DRIFTCHECK")"

# Stacked PRs that came back MERGED on GitHub but never actually reached the
# real base branch (see wiki/lessons/pr-apilado-mergeado-nunca-llega-a-main.md,
# example-repo#17 case). Same contract as devbrain-drift (exit 0/1/2, TSV), but
# it's a different category -- git-remote state, not knowledge stores -- which
# is why it lives in its own script instead of being a fifth devbrain-drift check.
STACKEDCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-stacked-pr-check"
STACKED="$(check stacked-pr "no orphaned stacked PRs" "orphaned stacked PR(s)" "$STACKEDCHECK")"

# Claims in wiki/status/*.md and wiki/services/*.md ("PR #99 not yet merged")
# that no longer match live GitHub -- the drift that bit
# <project-a>.md, <project-b>.md and automations.md for days to weeks in the
# same week. Same contract and same reason it's reported, not repaired here,
# as DRIFT and STACKED above: fixing wiki wording needs judgement about what
# to say, not just a state flip.
STATUSCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-wiki-status-audit"
STALE="$(check wiki-status-audit "no outdated claims" "outdated claim(s)" "$STATUSCHECK")"

echo "[$(date)] wiki-lint done ($LINKS · $DRIFT · $STACKED · $STALE): $SUMMARY" >> "$LOG"
# Same gap the digest had: this only runs weekly, so a silent gateway
# outage could go unnoticed for a week. tg_send_with_fallback tries openclaw first,
# reaches for curl only if that fails, and tags the message when it does.
tg_send_with_fallback "$OPENCLAW_BIN" \
  "🧹 Weekly wiki lint ($LINKS · $DRIFT · $STACKED · $STALE): ${SUMMARY:-done (see log)}" "$LOG"
