#!/bin/bash
# devbrain-wiki-lint — mantenimiento semanal de la wiki (patron Karpathy: lint).
# Claude Code busca contradicciones, datos obsoletos, paginas huerfanas; arregla y commitea.
# Diseno: ARCHITECTURE.md (seccion sobre mantenimiento de wiki). Corre semanal via launchd.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
WIKI="$HOME/dev/wiki"
if [ -z "${DEVBRAIN_TG_CHAT_ID:-}" ]; then
  echo "devbrain-wiki-lint: DEVBRAIN_TG_CHAT_ID no esta seteado (tu chat id de Telegram)." >&2
  echo "devbrain-wiki-lint: no hay valor por defecto -- seteala en el entorno antes de correr esto." >&2
  exit 1
fi
TG_ID="$DEVBRAIN_TG_CHAT_ID"
LOG="$HOME/.openclaw/logs/wiki-lint.log"
OPENCLAW_BIN="${DEVBRAIN_WIKI_LINT_OPENCLAW_BIN:-openclaw}"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/telegram.sh"   # tg_send_with_fallback
echo "[$(date)] wiki-lint start" >> "$LOG"
cd "$WIKI" || exit 1

# Link resolution is decidable, so decide it instead of asking the model to
# eyeball ~240 links (that is the blind-verification trap from
# wiki/lessons/verificacion-ciega-probar-el-instrumento.md). The model gets an
# exact list to repair and spends its judgement on the parts that need it.
LINKCHECK="$(cd "$(dirname "$0")" && pwd)/wiki-linkcheck"
BROKEN="$("$LINKCHECK" "$WIKI" 2>&1)"
echo "[$(date)] wiki-lint linkcheck: $(printf '%s' "$BROKEN" | head -2 | tr '\n' ' ')" >> "$LOG"

SUMMARY=$(claude -p --permission-mode acceptEdits \
  --allowedTools "Read,Glob,Grep,Edit,Write,Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*)" \
  "Eres el mantenedor de esta wiki (~/dev/wiki). Lee SCHEMA.md para las reglas. Haz un LINT:
1) Busca contradicciones entre paginas, datos obsoletos, y paginas huerfanas (sin enlaces).
2) Verifica que index.md liste todas las paginas. Los enlaces rotos YA estan detectados —
   este es el reporte de \`wiki-linkcheck\`, arregla exactamente estos y ninguno mas:
--- inicio del reporte ---
$BROKEN
--- fin del reporte ---
   Para cada uno: si la pagina existe con otro nombre, reapunta el enlace; si no existe en
   la wiki, convertilo a texto plano. NUNCA inventes una pagina para satisfacer un enlace.
   Usa enlaces markdown relativos, el formato que pide SCHEMA.md.
3) Arregla lo que puedas directamente (ediciones pequenas y seguras). NO borres paginas.
4) Registra el pase en log.md con formato '## [YYYY-MM-DD] lint | resumen'.
5) Haz commit de los cambios con mensaje 'wiki: lint semanal'. NO hagas push.
Al final responde en espanol, 1-3 lineas, que encontraste y arreglaste." 2>>"$LOG")

git push -q 2>>"$LOG" || true   # push del commit del lint

# Verify the repair actually landed. Trusting the model's own summary here is
# the same mistake this script exists to stop.
if "$LINKCHECK" --quiet "$WIKI"; then
  LINKS="enlaces OK"
else
  LINKS="⚠️ quedan $("$LINKCHECK" "$WIKI" | sed -n 's/^unresolved: //p') enlaces rotos"
fi

# Drift between stores, and orphaned stacked-PR merges, are reported, never
# repaired here: fixing either means writing to machine-config (drift) or to
# someone else's repo history (stacked PRs), and machine-config is
# interactive-only (see wiki/lessons/machine-config-nunca-nocturno.md).
# That is also why neither report is handed to the model above the way broken
# links are.
DRIFTCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-drift"
if "$DRIFTCHECK" --quiet; then
  DRIFT="sin drift"
else
  DRIFT="⚠️ $("$DRIFTCHECK" | sed -n 's/^drift: //p') drift entre almacenes"
  echo "[$(date)] wiki-lint drift:" >> "$LOG"
  "$DRIFTCHECK" >> "$LOG" 2>&1
fi

# PRs apilados que salieron MERGED en GitHub pero nunca llegaron a la rama base
# real (ver wiki/lessons/pr-apilado-mergeado-nunca-llega-a-main.md, caso
# example-repo#17). Mismo contrato que devbrain-drift (exit 0/1/2, TSV), pero
# es una categoria distinta -- estado de git remoto, no almacenes de
# conocimiento -- por eso vive en su propio script en vez de ser un quinto
# chequeo de devbrain-drift.
STACKEDCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-stacked-pr-check"
if "$STACKEDCHECK" --quiet; then
  STACKED="sin PRs apilados huerfanos"
else
  STACKED="⚠️ $("$STACKEDCHECK" | sed -n 's/^stacked-pr: //p') PR(s) apilado(s) huerfano(s)"
  echo "[$(date)] wiki-lint stacked-pr:" >> "$LOG"
  "$STACKEDCHECK" >> "$LOG" 2>&1
fi

# Claims in wiki/status/*.md and wiki/services/*.md ("PR #99 sin mergear",
# "<job>: pendiente") that no longer match live GitHub -- the drift that bit
# <project-a>.md, <project-b>.md and automations.md for days to weeks in the
# same week. Same contract and same reason it's reported, not repaired here,
# as DRIFT and STACKED above: fixing wiki wording needs judgement about what
# to say, not just a state flip.
STATUSCHECK="$(cd "$(dirname "$0")" && pwd)/devbrain-wiki-status-audit"
if "$STATUSCHECK" --quiet; then
  STALE="sin claims desactualizados"
else
  STALE="⚠️ $("$STATUSCHECK" | sed -n 's/^wiki-status-audit: //p') claim(s) desactualizado(s)"
  echo "[$(date)] wiki-lint wiki-status-audit:" >> "$LOG"
  "$STATUSCHECK" >> "$LOG" 2>&1
fi

echo "[$(date)] wiki-lint done ($LINKS · $DRIFT · $STACKED · $STALE): $SUMMARY" >> "$LOG"
# Same gap the digest had: this only runs weekly, so a silent gateway
# outage could go unnoticed for a week. tg_send_with_fallback tries openclaw first,
# reaches for curl only if that fails, and tags the message when it does.
tg_send_with_fallback "$OPENCLAW_BIN" \
  "🧹 Lint semanal de la wiki ($LINKS · $DRIFT · $STACKED · $STALE): ${SUMMARY:-completado (ver log)}" "$LOG"
