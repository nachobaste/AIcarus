#!/bin/bash
# devbrain-day — the day-shift ritual: shows pending proposals from the research
# shift, one at a time, and your "dale" (go ahead) writes them into the queue as
# approved plans.
#
# The engine (lib/day.sh: day_apply) is the same one a Telegram-based approval
# path would use — this command is just the terminal interface over that engine.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$ROOT/lib/queue.sh"
source "$ROOT/lib/day.sh"

WIKI_DIR="${DEVBRAIN_WIKI_DIR:-$HOME/dev/wiki}"
BACKLOG="$WIKI_DIR/projects/mejoras-propuestas.md"
DAY_ENGINE="${DAY_ENGINE:-$ROOT/lib/day_engine.py}"
export DAY_ENGINE
export RESEARCH_ALLOWFILE="${RESEARCH_ALLOWFILE:-$ROOT/devbrain-projects.allow}"

if [ ! -f "$BACKLOG" ]; then
  echo "No backlog yet ($BACKLOG). Nothing to decide."
  exit 0
fi

# Snapshot of pending titles AT THE START of this run. Processed by title, not
# position: if an earlier decision modifies the backlog, the position of the
# remaining ones could shift, but the title of a proposal already shown never
# changes.
# No `mapfile`: bash 3.2 (macOS default) doesn't have it — see bin/devbrain-research's
# pick_repos() for the same lesson, learned there first.
TITLES=()
while IFS= read -r LINE; do
  [ -n "$LINE" ] && TITLES+=("$LINE")
done < <(python3 "$DAY_ENGINE" list < "$BACKLOG")

if [ "${#TITLES[@]}" -eq 0 ]; then
  echo "No pending proposals. Nothing to decide today."
  exit 0
fi

echo "${#TITLES[@]} pending proposal(s)."
echo

DECIDED=0
for TITLE in "${TITLES[@]}"; do
  # May have already been decided by an earlier run of this same session (shouldn't
  # happen, each title appears once) or by another source — 'show' refuses if it's
  # no longer pending.
  DETAIL="$(python3 "$DAY_ENGINE" show "$TITLE" < "$BACKLOG" 2>/dev/null)" || continue

  echo "────────────────────────────────────────"
  printf '%s\n' "$DETAIL"
  echo
  printf 'Decision (dale [A|B] / no / later) > '
  read -r RESP || RESP=""

  # When in doubt, don't approve: anything that isn't exactly "dale[ A|B]" or "no"
  # is treated as "later". An ambiguous reply never writes anything.
  case "$(printf '%s' "$RESP" | tr '[:upper:]' '[:lower:]' | xargs 2>/dev/null)" in
    dale | "dale a")
      OUT="$(day_apply "$TITLE" dale "" A 2>&1)"; RC=$?
      ;;
    "dale b")
      OUT="$(day_apply "$TITLE" dale "" B 2>&1)"; RC=$?
      ;;
    no)
      printf 'Reason for discarding (required) > '
      read -r REASON || REASON=""
      while [ -z "$(printf '%s' "$REASON" | xargs 2>/dev/null)" ]; do
        printf 'The reason cannot be empty — research repeats the same mistake without it.\nReason > '
        read -r REASON || REASON=""
      done
      OUT="$(day_apply "$TITLE" no "$REASON" 2>&1)"; RC=$?
      ;;
    *)
      echo "→ Stays pending for the next cycle."
      continue
      ;;
  esac

  echo "$OUT"
  [ $RC -eq 0 ] && DECIDED=$((DECIDED + 1))
  echo
done

echo "────────────────────────────────────────"
echo "Done: $DECIDED of ${#TITLES[@]} decided in this run."
