{
  "version": 1,
  "defaults": {
    "security": "deny",
    "ask": "off",
    "askFallback": "deny",
    "autoAllowSkills": false
  },
  "agents": {
    "main": {
      "security": "allowlist",
      "ask": "off",
      "askFallback": "deny",
      "autoAllowSkills": false,
      "allowlist": [
        {
          "pattern": "/ABSOLUTE/PATH/TO/YOUR/CLONE/OF/THIS/REPO/bin/devbrain"
        },
        {
          "pattern": "/ABSOLUTE/PATH/TO/YOUR/CLONE/OF/THIS/REPO/bin/devbrain-queue"
        }
      ]
    }
  }
}
